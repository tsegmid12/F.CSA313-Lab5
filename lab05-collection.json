              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/courses/CS313",
              "host": ["{{baseUrl}}"],
              "path": ["courses", "CS313"]
            }
          }
        },
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Result is OK\", function () { var jsonData = pm.response.json(); pm.expect(jsonData.result).to.eql(\"OK\"); });",
                  "pm.test(\"RegistrationID is a number\", function () { var jsonData = pm.response.json(); pm.expect(jsonData.registrationID).to.be.a('number'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\": \"B231234567\", \"courseID\": \"CS313\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": ["{{baseUrl}}"],
              "path": ["registrations"]
            }
          }
        }
      ]
